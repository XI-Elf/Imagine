@@ -0,0 +1,346 @@
+{
+  "version": 1,
+  "title": "Пепел помнит имена",
+  "premise": "После катастрофы Эшвик держится на старых стенах и чужих тайнах. Сигнал из-под земли зовёт не к спасению, а к выбору: кому достанется право решить, что останется от прежнего мира.",
+  "characters": [
+    {
+      "id": "mara_vey",
+      "name": "Мара Вей",
+      "role": "Смотрительница маяка",
+      "motive": "Хочет восстановить маяк, чтобы предупреждать поселения о волнах влияния проклятия. Скрывает, что прежний запуск маяка погубил её отряд.",
+      "voice": "Говорит коротко, не просит доверия и всегда называет цену решения."
+    },
+    {
+      "id": "brann",
+      "name": "Бранн Керн",
+      "role": "Капитан ворот",
+      "motive": "Считает порядок единственной защитой Эшвика. Боится, что открытая правда вызовет панику и расколет город.",
+      "voice": "Резкий, практичный, говорит языком долга и последствий."
+    },
+    {
+      "id": "sister_elen",
+      "name": "Сестра Элен",
+      "role": "Хранительница приюта",
+      "motive": "Спасает людей, которых городские власти записали в пропавшие. Готова нарушить любой приказ ради живых.",
+      "voice": "Спокойная, внимательная к деталям, не осуждает слабость."
+    },
+    {
+      "id": "oren",
+      "name": "Орен Соль",
+      "role": "Мастер-ремесленник",
+      "motive": "Изучает янтарные фрагменты и надеется вернуть утраченные ремёсла. Не доверяет ни культу, ни городской страже.",
+      "voice": "Объясняет через устройство вещей, любит точные определения."
+    },
+    {
+      "id": "the_witness",
+      "name": "Свидетель",
+      "role": "Голос из-под земли",
+      "motive": "Пытается завершить незаконченный протокол маяка; неясно, человек ли это, память или чужой разум.",
+      "voice": "Повторяет знакомые слова с неверными интонациями."
+    }
+  ],
+  "chapters": [
+    {
+      "id": "signal",
+      "title": "I. Сигнал под стеной",
+      "summary": "У южных ворот Эшвика Мара передаёт герою обрывок сигнала. Бранн требует молчать, Элен просит сначала найти пропавших у старого водосброса.",
+      "dialogue": [
+        {
+          "speaker": "Мара Вей",
+          "text": "Слышишь низкий звон? Он идёт не с неба. Под камнем есть второй город — и он проснулся."
+        },
+        {
+          "speaker": "Бранн Керн",
+          "text": "Никаких вылазок без приказа. Последний, кто пошёл на этот звук, вернулся без имени."
+        },
+        {
+          "speaker": "Сестра Элен",
+          "text": "Если пойдёшь к водосбросу, ищи людей, не ответы. Ответы умеют ждать."
+        }
+      ],
+      "objective": {
+        "event": "city_enter",
+        "target": "s001",
+        "count": 1
+      },
+      "choice": {
+        "id": "first_oath",
+        "prompt": "Кому доверить первые сведения?",
+        "options": [
+          {
+            "id": "guard",
+            "title": "Передать сигнал Бранну",
+            "description": "Усилить порядок и получить пропуск стражи.",
+            "effects": {
+              "guard_reputation": 1,
+              "refugee_reputation": -1
+            },
+            "flag": "told_guard",
+            "items": {}
+          },
+          {
+            "id": "refugees",
+            "title": "Помочь Элен и скрыть сигнал",
+            "description": "Приют получит поддержку, но стража станет подозрительнее.",
+            "effects": {
+              "guard_reputation": -1,
+              "refugee_reputation": 1
+            },
+            "flag": "aided_refugees",
+            "items": {}
+          }
+        ]
+      }
+    },
+    {
+      "id": "names",
+      "title": "II. Имена в журнале",
+      "summary": "В старом журнале водосброса перечислены люди, которых официально никогда не существовало. Орен узнаёт почерк инженеров маяка.",
+      "dialogue": [
+        {
+          "speaker": "Орен Соль",
+          "text": "Это не список погибших. Видишь одинаковые пропуски? Здесь вычеркнули не людей — целые смены. Кто-то переписал журнал после запуска."
+        },
+        {
+          "speaker": "Мара Вей",
+          "text": "Я не прошу меня оправдать. Найди страницу с отметкой янтарного ключа. Тогда поймёшь, почему я осталась."
+        }
+      ],
+      "objective": {
+        "event": "city_quest",
+        "target": "s001",
+        "count": 1
+      },
+      "choice": {
+        "id": "ledger_truth",
+        "prompt": "Что сделать с найденной страницей?",
+        "options": [
+          {
+            "id": "publish",
+            "title": "Открыть её жителям",
+            "description": "Город узнает правду; доверие к власти снизится.",
+            "effects": {
+              "public_truth": 1,
+              "guard_reputation": -1
+            },
+            "flag": "ledger_public",
+            "items": {
+              "flooded_ledger_page": 1
+            }
+          },
+          {
+            "id": "seal",
+            "title": "Передать страницу Маре",
+            "description": "Сохранить спокойствие и дать Маре время подготовиться.",
+            "effects": {
+              "mara_trust": 1,
+              "public_truth": -1
+            },
+            "flag": "ledger_sealed",
+            "items": {
+              "flooded_ledger_page": 1
+            }
+          }
+        ]
+      }
+    },
+    {
+      "id": "amber_trace",
+      "title": "III. След янтаря",
+      "summary": "След ведёт к затопленной часовне за старой дорогой. Там хранится янтарный ключ — не украшение, а часть механизма, удерживающего сигнал.",
+      "dialogue": [
+        {
+          "speaker": "Свидетель",
+          "text": "Ключ не открывает дверь. Он напоминает двери, что она когда-то была стеной."
+        },
+        {
+          "speaker": "Орен Соль",
+          "text": "Не вставляй его в первый попавшийся паз. Устройство отвечает на тепло, но запоминает руку."
+        }
+      ],
+      "objective": {
+        "event": "travel_km",
+        "target": "",
+        "count": 3
+      },
+      "choice": {
+        "id": "key_use",
+        "prompt": "Как поступить с янтарным ключом?",
+        "options": [
+          {
+            "id": "study",
+            "title": "Отдать ключ Орену для изучения",
+            "description": "Открывает ремесленную ветвь и снижает риск при настройке механизма.",
+            "effects": {
+              "craft_knowledge": 1
+            },
+            "flag": "key_studied",
+            "items": {
+              "amber_key_fragment": 1
+            }
+          },
+          {
+            "id": "return",
+            "title": "Вернуть ключ Маре",
+            "description": "Укрепляет доверие Мары, но часть сведений останется скрытой.",
+            "effects": {
+              "mara_trust": 1
+            },
+            "flag": "key_returned",
+            "items": {
+              "amber_key_fragment": 1
+            }
+          }
+        ]
+      }
+    },
+    {
+      "id": "warden",
+      "title": "IV. Сторож без лица",
+      "summary": "У затопленной часовни стоит страж механизма — существо, собранное из костяных пластин, корней и старых сигнальных колец. Оно не охраняет сокровище. Оно удерживает проход.",
+      "dialogue": [
+        {
+          "speaker": "Свидетель",
+          "text": "Не называй его чудовищем. Он всё ещё выполняет приказ, которого больше никто не помнит."
+        }
+      ],
+      "objective": {
+        "event": "boss_defeated",
+        "target": "boss_warden",
+        "count": 1
+      }
+    },
+    {
+      "id": "beacon",
+      "title": "V. Сердце маяка",
+      "summary": "За часовней находится узел старого маяка. Последний запуск может предупредить другие поселения, но разбудит то, что отвечает из-под земли.",
+      "dialogue": [
+        {
+          "speaker": "Мара Вей",
+          "text": "Я однажды выбрала за всех. Больше не буду. Скажи, что мы должны оставить после себя."
+        },
+        {
+          "speaker": "Свидетель",
+          "text": "ПРОТОКОЛ НЕ ЗАВЕРШЁН. НАЗОВИТЕ ТЕХ, КТО ОСТАНЕТСЯ."
+        }
+      ],
+      "objective": {
+        "event": "boss_defeated",
+        "target": "boss_beacon_core",
+        "count": 1
+      },
+      "choice": {
+        "id": "ending",
+        "prompt": "Как завершить работу маяка?",
+        "options": [
+          {
+            "id": "warn",
+            "title": "Запустить маяк на полную мощность",
+            "description": "Другие поселения получат предупреждение; проклятые земли станут активнее.",
+            "effects": {
+              "world_warning": 1,
+              "curse_pressure": 1
+            },
+            "flag": "ending_warning",
+            "items": {
+              "beacon_lens": 1
+            }
+          },
+          {
+            "id": "silence",
+            "title": "Погасить сигнал навсегда",
+            "description": "Эшвик сохранит тишину, но дальние поселения останутся без предупреждения.",
+            "effects": {
+              "world_warning": -1,
+              "curse_pressure": -1
+            },
+            "flag": "ending_silence",
+            "items": {
+              "beacon_lens": 1
+            }
+          }
+        ]
+      }
+    },
+    {
+      "id": "epilogue",
+      "title": "Эпилог. Те, кто помнит",
+      "summary": "Решение героя становится частью новой летописи Эшвика. У города меняется знамя, а в хронике появляется запись о том, что было сохранено и чем пришлось заплатить.",
+      "objective": {
+        "event": "ending_chosen",
+        "target": "",
+        "count": 1
+      }
+    }
+  ],
+  "locations": [
+    {
+      "id": "flooded_chapel",
+      "name": "Затопленная часовня",
+      "position": [
+        3017.9,
+        13553.6
+      ],
+      "radius": 90,
+      "description": "Полузатопленная часовня, проросшая корнями; вход отмечен тремя янтарными кольцами.",
+      "unlock_chapter": "amber_trace"
+    },
+    {
+      "id": "beacon_core",
+      "name": "Подземное сердце маяка",
+      "position": [
+        6517.9,
+        19553.6
+      ],
+      "radius": 100,
+      "description": "Старая сигнальная камера под разрушенным наблюдательным пунктом.",
+      "unlock_chapter": "beacon"
+    }
+  ],
+  "bosses": [
+    {
+      "id": "boss_warden",
+      "name": "Сторож без лица",
+      "creature": "amber_warden",
+      "location": "flooded_chapel",
+      "terrain": "swamp",
+      "biome": 5,
+      "description": "Бронированный страж прохода. Уязвим к дробящему оружию; его янтарное ядро вспыхивает перед тяжёлым ударом."
+    },
+    {
+      "id": "boss_beacon_core",
+      "name": "Эхо протокола",
+      "creature": "beacon_echo",
+      "location": "beacon_core",
+      "terrain": "rad_wasteland",
+      "biome": 8,
+      "description": "Сгусток памяти и проклятого янтаря. Меняет темп боя и поддерживает себя импульсами сигнала."
+    }
+  ],
+  "story_items": [
+    {
+      "id": "amber_key_fragment",
+      "name": "Фрагмент янтарного ключа",
+      "description": "Тёплый на ощупь фрагмент старого механизма. На срезе видны концентрические линии, похожие на годовые кольца дерева.",
+      "category": "quest",
+      "weight": 0.2,
+      "unique": true
+    },
+    {
+      "id": "flooded_ledger_page",
+      "name": "Страница журнала водосброса",
+      "description": "Мокрая страница с перечнем вычеркнутых смен и отметкой янтарного ключа.",
+      "category": "quest",
+      "weight": 0.05,
+      "unique": true
+    },
+    {
+      "id": "beacon_lens",
+      "name": "Линза сигнального маяка",
+      "description": "Треснувшая линза, которая собирает слабый свет в узкий янтарный луч.",
+      "category": "quest",
+      "weight": 0.6,
+      "unique": true
+    }
+  ]
+}
