extends SceneTree
const Campaign := preload("res://story/campaign.gd")
func _initialize() -> void:
    var d: Dictionary = Campaign.data()
    assert(d.get("chapters", []).size() == 6)
    assert(d.get("characters", []).size() >= 5)
    assert(d.get("bosses", []).size() == 2)
    var s: Dictionary = Campaign.fresh()
    assert(Campaign.record(s, "city_enter", "s001"))
    assert(s.get("awaiting_choice", false))
    assert(Campaign.choose(s, "invalid").is_empty())
    assert(Campaign.choose(s, "refugees").get("id", "") == "refugees")
    assert(Campaign.current(s).get("id", "") == "names")
    assert(Campaign.record(s, "city_quest", "s001"))
    assert(Campaign.choose(s, "publish").get("id", "") == "publish")
    for i in 3: assert(Campaign.record(s, "travel_km"))
    assert(Campaign.choose(s, "study").get("id", "") == "study")
    assert(Campaign.boss_unlocked(s, "boss_warden"))
    assert(Campaign.record(s, "boss_defeated", "boss_warden"))
    assert(Campaign.boss_unlocked(s, "boss_beacon_core"))
    assert(Campaign.record(s, "boss_defeated", "boss_beacon_core"))
    assert(Campaign.choose(s, "warn").get("id", "") == "warn")
    assert(Campaign.is_complete(s))
    print("story_campaign_checks: OK")
    quit()
