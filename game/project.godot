; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Amber World"
run/main_scene="res://main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/quit_on_go_back=false
config/icon="res://art/android/icon.png"

[autoload]

LangBoot="*res://i18n/i18n.gd"
ComicSkin="*res://ui/comic_skin.gd"
Worlds="*res://worlds/worlds.gd"
Tutorial="*res://tutorial/tutorial.gd"
Sfx="*res://audio/sfx.gd"
MobileControls="*res://ui/mobile_controls.gd"
Music="*res://audio/music.gd"

[display]

window/size/viewport_width=1366
window/size/viewport_height=800

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0


[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/uk.po")
locale/fallback="ru"

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false
