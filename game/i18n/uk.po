msgid "Мастеру больше нечему вас учить"
msgstr "Майстрові більше нічого вас навчити"

#: city/craft.gd
msgid "Не вышло (%s): работа испорчена, часть материалов пропала"
msgstr "Не вийшло (%s): роботу зіпсовано, частина матеріалів пропала"

#: city/craft.gd
msgid "Не хватает материалов"
msgstr "Бракує матеріалів"

#: city/craft.gd
msgid "Нет такого рецепта"
