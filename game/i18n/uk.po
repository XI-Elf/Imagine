msgstr "Записано до щоденника героя (вкладка 6)."

#: city/city_world.gd
msgid "Здоровье %d  Сытость %d  Вода %d  Энергия %d  Силы %d   Деньги %d   Груз %.1f кг%s"
msgstr "Здоров'я %d  Ситість %d  Вода %d  Енергія %d  Сили %d   Гроші %d   Вантаж %.1f кг%s"

#: city/city_world.gd
msgid "Комната снята"
msgstr "Кімнату знято"

#: city/city_world.gd
msgid "Купить: %s ×%d — %d"
msgstr "Купити: %s ×%d — %d"

#: city/city_world.gd
msgid "ЛКМ или WASD идти · ПКМ стоп · Shift бег · E говорить · I персонаж · Tab сумка · M план"
msgstr "ЛКМ або WASD іти · ПКМ стоп · Shift біг · E говорити · I персонаж · Tab торба · M план"

#: city/city_world.gd
msgid "Лечиться (%d)"
msgstr "Лікуватися (%d)"

#: city/city_world.gd
msgid "Мастер такого не умеет: только своими руками."
msgstr "Майстер такого не вміє: тільки власними руками."

#: city/city_world.gd
msgid "Мастерская"
msgstr "Майстерня"

#: city/city_world.gd
msgid "Материалы: %s"
msgstr "Матеріали: %s"

#: city/city_world.gd
msgid "Награда: %d монет."
msgstr "Нагорода: %d монет."

#: city/city_world.gd
msgid "Награда: %d монет. Город вырастет."
msgstr "Нагорода: %d монет. Місто виросте."

#: city/city_world.gd
msgid "Назад"
msgstr "Назад"

#: city/city_world.gd
msgid "Найдено: %s"
msgstr "Знайдено: %s"

#: city/city_world.gd
msgid "Напился из колодца"
msgstr "Напився з колодязя"

#: city/city_world.gd
msgid "Не вышло: камни скользкие"
msgstr "Не вийшло: каміння слизьке"

#: city/city_world.gd
msgid "Не хватает денег"
msgstr "Бракує грошей"

#: city/city_world.gd
msgid "Не хватает: %s"
msgstr "Бракує: %s"

#: city/city_world.gd
msgid "Новых поручений нет."
msgstr "Нових доручень немає."

#: city/city_world.gd
msgid "Нужен навык: %d"
msgstr "Потрібна навичка: %d"

#: city/city_world.gd
msgid "Перелез через стену и спрыгнул в темноту"
msgstr "Переліз через стіну й зістрибнув у темряву"

#: city/city_world.gd
msgid "Перелезть стену"
msgstr "Перелізти стіну"

#: city/city_world.gd
msgid "Поплатился за отказ: %s."
msgstr "Поплатився за відмову: %s."

#: city/city_world.gd
msgid "Поручение"
msgstr "Доручення"

#: city/city_world.gd
msgid "Поручение: %s"
msgstr "Доручення: %s"

#: city/city_world.gd
msgid "Поручения (%d)"
msgstr "Доручення (%d)"

#: city/city_world.gd
msgid "Поручения: %s"
msgstr "Доручення: %s"

#: city/city_world.gd
msgid "Поступил по совести: %s."
msgstr "Вчинив за совістю: %s."

#: city/city_world.gd
msgid "Починить вещи (%d)"
msgstr "Полагодити речі (%d)"

#: city/city_world.gd
msgid "Продать: %s ×%d — %d"
msgstr "Продати: %s ×%d — %d"

#: city/city_world.gd
msgid "Работа: %s"
msgstr "Робота: %s"

#: city/city_world.gd
msgid "Разговор"
msgstr "Розмова"

#: city/city_world.gd
msgid "Расспросить о былом"
msgstr "Розпитати про минуле"

#: city/city_world.gd
msgid "Расспросить о былом (угостить, %d)"
msgstr "Розпитати про минуле (пригостити, %d)"

#: city/city_world.gd
msgid "Расспросить о городе"
msgstr "Розпитати про місто"

#: city/city_world.gd
msgid "Самому: %s"
msgstr "Самому: %s"

#: city/city_world.gd
msgid "Сдать поручение"
msgstr "Здати доручення"

#: city/city_world.gd
msgid "Сделать самому (шанс %d %%, выносливость −%d)"
msgstr "Зробити самому (шанс %d %%, витривалість −%d)"

#: city/city_world.gd
msgid "Снять комнату до утра (%d)"
msgstr "Зняти кімнату до ранку (%d)"

#: city/city_world.gd
msgid "Сорвался со стены и ушиб руку"
msgstr "Зірвався зі стіни й забив руку"

#: city/city_world.gd
msgid "Спит. Будить не стоит."
msgstr "Спить. Будити не варто."

#: city/city_world.gd
msgid "Стража взяла у стены города %s и отвела в казарму. Штраф заплачен."
msgstr "Варта схопила біля стіни міста %s і відвела до казарми. Штраф сплачено."

#: city/city_world.gd
msgid "Стража стащила со стены: штраф %d"
msgstr "Варта стягнула зі стіни: штраф %d"

#: city/city_world.gd
msgid "Тайком перелез через стену города %s: ворота для таких, как я, не для всех открыты."
msgstr "Крадькома переліз через стіну міста %s: брама не для всіх відчинена."

#: city/city_world.gd
msgid "Торговля: %s"
msgstr "Торгівля: %s"

#: city/city_world.gd
msgid "Уйти"
msgstr "Піти"

#: city/city_world.gd
msgid "Урок пройден"
msgstr "Урок пройдено"

#: city/city_world.gd
msgid "Услышал от %s: «%s». Записано в дневник."
msgstr "Почув від %s: «%s». Записано до щоденника."

#: city/city_world.gd
msgid "Учиться у мастера (%d)"
msgstr "Учитися в майстра (%d)"

#: city/city_world.gd
msgid "вы перелезли через стену. Не попадайтесь страже"
msgstr "ви перелізли через стіну. Не трапляйтеся варті"

#: city/city_world.gd
msgid "вылечено"
msgstr "вилікувано"

#: city/city_world.gd
msgid "житель"
msgstr "мешканець"

#: city/city_world.gd
msgid "исподлобья, с неприязнью"
msgstr "спідлоба, з неприязню"

#: city/city_world.gd
msgid "казарму"
msgstr "казарму"

#: city/city_world.gd
msgid "кожевник"
msgstr "кожум'яка"

#: city/city_world.gd
msgid "лечь спать"
msgstr "лягти спати"

#: city/city_world.gd
msgid "обыскать"
msgstr "обшукати"

#: city/city_world.gd
msgid "олдермен"
msgstr "олдермен"

#: city/city_world.gd
msgid "осмотреть"
msgstr "оглянути"

#: city/city_world.gd
msgid "побед %d из %d"
msgstr "перемог %d з %d"

#: city/city_world.gd
msgid "почти дружелюбно"
msgstr "майже приязно"

#: city/city_world.gd
msgid "пройдено %.1f из %d км"
msgstr "пройдено %.1f з %d км"

#: city/city_world.gd
msgid "равнодушно, как на мебель"
msgstr "байдуже, як на меблі"

#: city/city_world.gd
msgid "стража поймала вас у стены и привела в %s. Штраф %d"
msgstr "варта спіймала вас біля стіни й привела в %s. Штраф %d"

#: city/city_world.gd
msgid "стражник"
msgstr "вартовий"

#: city/city_world.gd
msgid "торговка"
msgstr "торговка"

#: city/city_world.gd
msgid "травница"
msgstr "травниця"

#: city/city_world.gd
msgid "хозяин таверны"
msgstr "господар таверни"

#: city/craft.gd
msgid "Здесь не учат"
msgstr "Тут не вчать"

#: city/craft.gd
msgid "Мастер такого не умеет"
msgstr "Майстер такого не вміє"

#: city/craft.gd
msgid "Мастеру больше нечему вас учить"
msgstr "Майстрові більше нічого вас навчити"

#: city/craft.gd
msgid "Не вышло (%s): работа испорчена, часть материалов пропала"
msgstr "Не вийшло (%s): роботу зіпсовано, частина матеріалів пропала"

#: city/craft.gd
msgid "Не хватает материалов"
msgstr "Бракує матеріалів"

#: city/craft.gd
msgid "Нет такого рецепта"
msgstr "Немає такого рецепта"

#: city/craft.gd
msgid "Нужен навык %d"
msgstr "Потрібна навичка %d"

#: city/craft.gd
msgid "Слишком устали: нужно %d выносливости"
msgstr "Надто втомилися: потрібно %d витривалості"

#: city/dialogue.gd
msgid "Ловкость"
msgstr "Спритність"

#: city/dialogue.gd
msgid "Обаяние"
msgstr "Чарівність"

#: city/dialogue.gd
msgid "Сила"
msgstr "Сила"

#: city/dialogue.gd
msgid "Стойкость"
msgstr "Стійкість"

#: city/dialogue.gd
msgid "Удача"
msgstr "Удача"

#: city/dialogue.gd
msgid "Ум"
msgstr "Розум"

#: city/dialogue.gd
msgid "Чутьё"
msgstr "Чуття"

#: city/dialogue.gd
msgid "Э-э… "
msgstr "Е-е… "

#: city/endless_quests.gd
msgid "Больных нечем кормить. Принеси %s с огородов."
msgstr "Хворих нічим годувати. Принеси %s з городів."

#: city/endless_quests.gd
msgid "Будет чем торговать. Держи."
msgstr "Буде чим торгувати. Тримай."

#: city/endless_quests.gd
msgid "Будут подковы. Плачу, как обещал."
msgstr "Будуть підкови. Плачу, як обіцяв."

#: city/endless_quests.gd
msgid "Весть разошлась. Ждём новых людей к зиме."
msgstr "Звістка розійшлася. Чекаємо нових людей до зими."

#: city/endless_quests.gd
msgid "Вода снесла межевые вехи. Обойди землю, %s, и поставь, где были."
msgstr "Вода знесла межові віхи. Обійди землю, %s, і постав, де були."

#: city/endless_quests.gd
msgid "Выковал новую партию. Проверь: победи %s и расскажи, как держит."
msgstr "Викував нову партію. Перевір: переможи %s і розкажи, як тримає."

#: city/endless_quests.gd
msgid "Гонец в деревни"
msgstr "Гонець у села"

#: city/endless_quests.gd
msgid "Горн не остынет. Держи плату."
msgstr "Горно не охолоне. Тримай плату."

#: city/endless_quests.gd
msgid "Дальний дозор"
msgstr "Далекий дозор"

#: city/endless_quests.gd
msgid "Держит, значит. Отдам страже."
msgstr "Тримає, отже. Віддам варті."

#: city/endless_quests.gd
msgid "Добрые шкуры. Держи за труды."
msgstr "Добрі шкури. Тримай за труди."

#: city/endless_quests.gd
msgid "Дорога без разбоя"
msgstr "Дорога без розбою"

#: city/endless_quests.gd
msgid "Железо для горна"
msgstr "Залізо для горна"

#: city/endless_quests.gd
msgid "Заезжие меняют древные монеты втридорога. Принеси %s, и поделим выгоду."
msgstr "Заїжджі міняють давні монети втридорога. Принеси %s, і поділимо зиск."

#: city/endless_quests.gd
msgid "Заказов больше, чем железа. Принеси %s."
msgstr "Замовлень більше, ніж заліза. Принеси %s."

#: city/endless_quests.gd
msgid "Звериные тропы"
msgstr "Звірині стежки"

#: city/endless_quests.gd
msgid "Зверь у чанов"
msgstr "Звір біля чанів"

#: city/endless_quests.gd
msgid "Зимой будут спрашивать тёплое. Принеси %s."
msgstr "Узимку питатимуть теплого. Принеси %s."

#: city/endless_quests.gd
msgid "Клинок в деле"
msgstr "Клинок у ділі"

#: city/endless_quests.gd
msgid "Купцы снова ездят. Город тебе обязан."
msgstr "Купці знову їздять. Місто тобі завдячує."

#: city/endless_quests.gd
msgid "Купцы спрашивают другой путь. Пройди %s и запомни дорогу."
msgstr "Купці питають іншого шляху. Пройди %s і запам'ятай дорогу."

#: city/endless_quests.gd
msgid "Лихорадочный корень растёт далеко за стеной. Пройди %s и примечай, где он."
msgstr "Пропасний корінь росте далеко за стіною. Пройди %s і примічай, де він."

#: city/endless_quests.gd
msgid "Лом на подковы"
msgstr "Брухт на підкови"

#: city/endless_quests.gd
msgid "Межи на месте, споров меньше."
msgstr "Межі на місці, суперечок менше."

#: city/endless_quests.gd
msgid "Межи после половодья"
msgstr "Межі після повені"

#: city/endless_quests.gd
msgid "Мех на зиму"
msgstr "Хутро на зиму"

#: city/endless_quests.gd
msgid "Монеты для казны"
msgstr "Монети до скарбниці"

#: city/endless_quests.gd
msgid "Монеты для менял"
msgstr "Монети для міняйл"

#: city/endless_quests.gd
msgid "На большой дороге снова грабят обозы. Отбейся от них: победи %s."
msgstr "На великій дорозі знову грабують валки. Відбийся від них: переможи %s."

#: city/endless_quests.gd
msgid "Надо снести весть по дальним дворам: в Эшвике рынок и защита. Пройди %s."
msgstr "Треба рознести звістку по далеких дворах: у Ешвіку ринок і захист. Пройди %s."

#: city/endless_quests.gd
msgid "Нашлись корни. Хватит на зиму отваров."
msgstr "Знайшлися корені. Вистачить на зиму відварів."

#: city/endless_quests.gd
msgid "Новобранцам нужен пример. Покажи им бой за стенами: победи %s."
msgstr "Новобранцям потрібен приклад. Покажи їм бій за стінами: переможи %s."

#: city/endless_quests.gd
msgid "Новый путь для обоза"
msgstr "Новий шлях для валки"

#: city/endless_quests.gd
msgid "Обойди дозором дальние земли, %s. Смотри, кто ходит у границ."
msgstr "Обійди дозором далекі землі, %s. Дивись, хто ходить біля кордонів."

#: city/endless_quests.gd
msgid "Обход больных"
msgstr "Обхід хворих"

#: city/endless_quests.gd
msgid "Овощи для лазарета"
msgstr "Овочі для лазарету"

#: city/endless_quests.gd
msgid "Овощи на ярмарку"
msgstr "Овочі на ярмарок"

#: city/endless_quests.gd
msgid "Опять повадился зверь к дубильне. Разберись: победи %s."
msgstr "Знову звадився звір до чинбарні. Розберися: переможи %s."

#: city/endless_quests.gd
msgid "Отчеканим новые хартии. Держи плату."
msgstr "Викарбуємо нові хартії. Тримай плату."

#: city/endless_quests.gd
msgid "Печатникам опять нужен древный металл. Принеси %s."
msgstr "Друкарям знову потрібен давній метал. Принеси %s."

#: city/endless_quests.gd
msgid "По фермам лежат больные, а мне не дойти. Пройди %s, расскажи, кто как."
msgstr "По фермах лежать хворі, а мені не дійти. Пройди %s, розкажи, хто як."

#: city/endless_quests.gd
msgid "Подков не напасёшься. Принеси %s из развалин."
msgstr "Підков не напасешся. Принеси %s із руїн."

#: city/endless_quests.gd
msgid "Похлёбка будет. Спасибо."
msgstr "Юшка буде. Дякую."

#: city/endless_quests.gd
msgid "Разбойники у стен"
msgstr "Розбійники біля стін"

#: city/endless_quests.gd
msgid "Расскажу обозникам. Вот твоя доля."
msgstr "Розкажу візникам. Ось твоя частка."

#: city/endless_quests.gd
msgid "Редкие корни"
msgstr "Рідкісні корені"

#: city/endless_quests.gd
msgid "Родник снова наш. Вода в нём лечит лучше моих отваров."
msgstr "Джерело знову наше. Вода в ньому лікує краще за мої відвари."

#: city/endless_quests.gd
msgid "Снова шайка у стен. Разгони их: победи %s."
msgstr "Знову зграя біля стін. Розжени їх: переможи %s."

#: city/endless_quests.gd
msgid "Стражники видели, как ты бился. Уважают."
msgstr "Вартові бачили, як ти бився. Шанують."

#: city/endless_quests.gd
msgid "Теперь знаю, к кому идти первой."
msgstr "Тепер знаю, до кого йти першою."

#: city/endless_quests.gd
msgid "Теперь копья держат как надо."
msgstr "Тепер списи тримають як слід."

#: city/endless_quests.gd
msgid "Тихо у чанов. Работа пошла."
msgstr "Тихо біля чанів. Робота пішла."

#: city/endless_quests.gd
msgid "Тропа к роднику"
msgstr "Стежка до джерела"

#: city/endless_quests.gd
msgid "Тропы нашлись. Будет кожа."
msgstr "Стежки знайшлися. Буде шкіра."

#: city/endless_quests.gd
msgid "У целебного родника завелось зверьё. Расчисти тропу: победи %s."
msgstr "Біля цілющого джерела завелася звірина. Розчисти стежку: переможи %s."

#: city/endless_quests.gd
msgid "Учения"
msgstr "Навчання"

#: city/endless_quests.gd
msgid "Хватит на пару плащей. Плачу."
msgstr "Вистачить на пару плащів. Плачу."

#: city/endless_quests.gd
msgid "Хорошая сделка. Твоя доля."
msgstr "Добра угода. Твоя частка."

#: city/endless_quests.gd
msgid "Хочу ставить силки, а троп не знаю. Пройди по лесам %s."
msgstr "Хочу ставити сильця, а стежок не знаю. Пройди лісами %s."

#: city/endless_quests.gd
msgid "Чаны пустуют. Принеси %s — волчьи, кабаньи, какие добудешь."
msgstr "Чани порожні. Принеси %s — вовчі, кабанячі, які здобудеш."

#: city/endless_quests.gd
msgid "Чисто, говоришь. Спать будем спокойней."
msgstr "Чисто, кажеш. Спатимемо спокійніше."

#: city/endless_quests.gd
msgid "Шкуры в чан"
msgstr "Шкури в чан"

#: city/endless_quests.gd
msgid "Ярмарка скоро, а прилавки пусты. Принеси %s."
msgstr "Ярмарок скоро, а прилавки порожні. Принеси %s."

#: city/endless_quests.gd
msgid "в двух боях"
msgstr "у двох боях"

#: city/endless_quests.gd
msgid "в одном бою"
msgstr "в одному бою"

#: city/endless_quests.gd
msgid "древную монету"
msgstr "давню монету"

#: city/endless_quests.gd
msgid "древные монеты"
msgstr "давні монети"

#: city/endless_quests.gd
msgid "древных монет"
msgstr "давніх монет"

#: city/endless_quests.gd
msgid "километр"
msgstr "кілометр"

#: city/endless_quests.gd
msgid "километра"
msgstr "кілометри"

#: city/endless_quests.gd
msgid "километров"
msgstr "кілометрів"

#: city/endless_quests.gd
msgid "куска металлолома"
msgstr "шматки металобрухту"

#: city/endless_quests.gd
msgid "кусков металлолома"
msgstr "шматків металобрухту"

#: city/endless_quests.gd
msgid "кусок металлолома"
msgstr "шматок металобрухту"

#: city/endless_quests.gd
msgid "пучка овощей"
msgstr "пучки овочів"

#: city/endless_quests.gd
